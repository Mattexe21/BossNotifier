<Target Name="PostBuild" AfterTargets="Build">
    <!-- Crea la struttura corretta con sottocartella BossNotifier -->
    <MakeDir Directories="$(ProjectDir)release\BepInEx\plugins\BossNotifier" />
    
    <!-- Copia DLL e JSON nella sottocartella -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)release\BepInEx\plugins\BossNotifier" />
    <Copy SourceFiles="$(TargetDir)custom_bosses.json" DestinationFolder="$(ProjectDir)release\BepInEx\plugins\BossNotifier" />
    
    <!-- Crea ZIP -->
    <ZipDirectory SourceDirectory="$(ProjectDir)release" DestinationFile="$(ProjectDir)BossNotifier-$(Version).zip" Overwrite="true" />
    <RemoveDir Directories="$(ProjectDir)release" />
</Target>

</Project>